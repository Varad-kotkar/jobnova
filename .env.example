# JobNova Production Environment Variables Template
# Copy this file to .env before starting services

# Application Settings
ENVIRONMENT=development
APP_NAME=JobNova
APP_VERSION=1.0.0
PORT=8000

# Security & Secret Keys
JWT_SECRET=replace_with_a_long_random_64_character_secret_key
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL=sqlite+aiosqlite:///./jobnova.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://jobnova_user:password123@postgres:5432/jobnova_db

# Cache Configuration (Redis / Memory fallback)
REDIS_URL=
# Production Redis example:
# REDIS_URL=redis://redis:6379/0

# External API Integrations (Optional)
# OPENAI_API_KEY=
# TELEGRAM_BOT_TOKEN=
