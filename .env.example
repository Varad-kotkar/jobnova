# JobNova Production Environment Variables Template
# Copy this file to .env before starting services

# Application Settings
ENVIRONMENT=development
APP_NAME=JobNova API
APP_VERSION=1.0.0
PORT=8000
LOG_LEVEL=INFO

# Security & Secrets
JWT_SECRET_KEY=replace_with_a_long_random_64_character_secret_key
ADMIN_EMAIL=admin@jobnova.com
ADMIN_PASSWORD=replace_with_a_strong_admin_password_2026

# CORS Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL=sqlite+aiosqlite:///./jobnova.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://jobnova_user:password123@postgres:5432/jobnova_db

# External API Integrations (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
FIREBASE_PROJECT_ID=
